{
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "ES6",
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./"
    // "paths": {
    //   "src/*": ["src/*"] // Alias for imports starting with "src/"
    // }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
